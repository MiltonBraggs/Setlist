{
  "name": "@setlist/desktop",
  "productName": "Setlist",
  "version": "0.1.0",
  "private": true,
  "description": "Setlist: setlist and performance control for Ableton Live",
  "main": "dist/main.cjs",
  "scripts": {
    "bundle": "esbuild src/main.ts --bundle --platform=node --format=cjs --target=node20 --outfile=dist/main.cjs --external:electron --external:@julusian/midi --external:serialport --external:bufferutil --external:utf-8-validate",
    "start": "npm run bundle && electron .",
    "build": "npm run bundle && electron-builder"
  },
  "dependencies": {
    "@julusian/midi": "^3.6.0"
  },
  "devDependencies": {
    "@setlist/server": "*",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0",
    "esbuild": "^0.24.0"
  },
  "build": {
    "appId": "app.setlist.desktop",
    "productName": "Setlist",
    "directories": { "output": "release" },
    "files": ["dist/**", "package.json"],
    "extraResources": [
      { "from": "../../packages/web/dist", "to": "web" },
      { "from": "../../remote-script/Setlist", "to": "remote-script", "filter": ["**/*.py"] },
      { "from": "icon.png", "to": "icon.png" }
    ],
    "asarUnpack": ["**/node_modules/@julusian/midi/**"],
    "icon": "icon-512.png",
    "win": { "target": "nsis" },
    "mac": { "target": "dmg", "category": "public.app-category.music" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
